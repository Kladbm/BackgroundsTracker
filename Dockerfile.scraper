FROM node:22-bookworm-slim

WORKDIR /app

COPY scraper/package.json scraper/package-lock.json /app/scraper/
RUN cd /app/scraper && npm ci --omit=dev

COPY scraper/ /app/scraper/

RUN mkdir -p \
    /app/public/data/backgrounds \
    /app/public/images/backgrounds \
    /app/public/images/events \
    /app/public/images/icons \
    /app/public/images/pokemon \
    /app/public/images/types

CMD ["node", "scraper/run-all.js"]
